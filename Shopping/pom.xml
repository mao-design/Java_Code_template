<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.5</version>
        <relativePath/>
    </parent>
    <groupId>com.example</groupId>
    <artifactId>shopping</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>
    <name>购物模版</name>
    <description>Vue 3 + Spring Boot 3</description>
    <modules>
        <module>shopping-common</module>       <!-- 公共模块：工具类、全局常量、统一异常处理 -->
        <module>shopping-product</module>      <!-- 商品服务：SPU/SKU管理、分类品牌、上下架 -->
        <module>shopping-inventory</module>    <!-- 库存服务：库存扣减/增加、流水记录、预警 -->
        <module>shopping-order</module>        <!-- 订单服务：订单创建、状态流转、取消逻辑 -->
        <module>shopping-payment</module>      <!-- 支付服务：微信/支付宝对接、回调处理、退款 -->
        <module>shopping-user</module>         <!-- 用户服务：登录注册、JWT令牌、会员积分、地址 -->
        <module>shopping-search</module>       <!-- 搜索服务：Elasticsearch数据同步与全文检索 -->
        <module>shopping-file</module>         <!-- 文件服务：图片/视频上传、OSS对象存储 -->
        <module>shopping-admin</module>        <!-- 后台管理：运营后台RESTful API与权限校验 -->
        <module>shopping-promotion</module>    <!-- 营销服务：优惠券核销、秒杀/拼团、满减活动 -->
        <module>shopping-bootstrap</module>    <!-- 启动模块 -->

    </modules>
    <properties>
        <java.version>17</java.version>
        <mybatis-plus.version>3.5.7</mybatis-plus.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>
                    mybatis-plus-spring-boot3-starter
                </artifactId>
                <version>
                    ${mybatis-plus.version}
                </version>
            </dependency>

            <dependency>
                <groupId>com.github.xiaoymin</groupId>
                <artifactId>knife4j-openapi3-jakarta-spring-boot-starter</artifactId>
                <version>4.5.0</version>
            </dependency>
        </dependencies>

    </dependencyManagement>

    <!--   Maven 是多模块项目时，父 pom 里的 <build> 默认会被子模块继承。 -->
    <build>
        <!--        只管理版本-->
        <pluginManagement>
            <plugins>
                <plugin>
                    <!--                    如果不设置 pluginManagement-->
                    <!--                    那么所以子项目就会自动继承该 maven 包，子项目中找不到 main 方法，所以就报错-->
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <configuration>
                        <excludes>
                            <exclude>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                            </exclude>
                        </excludes>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
